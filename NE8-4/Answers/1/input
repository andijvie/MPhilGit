DEFINE pwr_geom
    xgrid 1 $pit          * x pitch = pit cm  
    ygrid 1 $pit          * y pitch = pit cm   --> 1x1 grid
    map 1001 1 1 1 1      * fill 1x1 grid with rod 1
    rodsub 1 1 $rad 1     * rod 1 has pellet radius of rad cm of material 1
    rodsub 1 2 0.00 2     * rod 1 is surrounded by material 2
